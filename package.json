{
  "name": "ghn",
  "version": "0.6.0",
  "private": true,
  "description": "Bulk-triage GitHub notifications in minutes. Local-first, uses your gh login.",
  "author": "Stefan Walther",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanwalther/ghn.git"
  },
  "bugs": "https://github.com/stefanwalther/ghn/issues",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build": "next build",
    "start": "./scripts/serve.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app lib db components tests --ext .ts,.tsx",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:fast": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run && playwright test",
    "coverage:check": "bash scripts/coverage-ratchet.sh",
    "db:push": "bun run scripts/push.ts",
    "db:seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.454.0",
    "next": "^15.1.6",
    "next-themes": "^0.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "^1.1.10",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "happy-dom": "21.0.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "5.0.5"
  }
}
